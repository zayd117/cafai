{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cafai.local/schema/taxonomy.schema.json",
  "title": "Capability taxonomy (plan §9 'Potential-need detection')",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "plain_name", "job_phrases", "need_signals", "skip_conditions", "native_coverage"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "fixture": { "type": "boolean" },
      "plain_name": { "type": "string", "minLength": 1 },
      "job_phrases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "need_signals": {
        "type": "array",
        "description": "Shape not specified by the plan (register A-019).",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "need_type"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "need_type": { "enum": ["implied", "latent"] }
          }
        }
      },
      "skip_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "native_coverage": {
        "type": "array",
        "description": "Which clients already cover this natively (plan §9).",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["client", "note"],
          "properties": {
            "client": { "type": "string" },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
