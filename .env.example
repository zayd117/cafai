# Server-side only. Never commit real values (plan §14: secrets in a managed store, never in repo/client/prompts/logs).
# Production (docs/DEPLOY.md): Vercel holds DATABASE_URL, QUOTA_SALT, CAFAI_CATALOG and later ANTHROPIC_API_KEY;
# the database admin login lives only in GitHub secrets (DATABASE_ADMIN_URL), never in the app.
# Runtime app role (subject to row-level security).
DATABASE_URL=postgres://cafai_app:<password>@localhost:5432/cafai_dev
# Migrations only (schema owner). Not available to the running app.
DATABASE_OWNER_URL=postgres://cafai_owner:<password>@localhost:5432/cafai_dev
# Catalog pipeline only (the one role that writes catalog_snapshots).
DATABASE_CATALOG_URL=postgres://cafai_catalog:<password>@localhost:5432/cafai_dev
# Real model calls (plan §9, §17). When unset the engine uses the MOCK provider (REGISTER A-017).
ANTHROPIC_API_KEY=
# Model provider: "anthropic" or "mock" (default: anthropic when ANTHROPIC_API_KEY is set). Per-call model overrides;
# default claude-sonnet-5-5 for all three calls (plan §9 cost math; REGISTER A-025).
CAFAI_MODEL_PROVIDER=
CAFAI_MODEL_UNDERSTANDING=
CAFAI_MODEL_JUDGMENT=
CAFAI_MODEL_EXPLANATION=
# Secret salt for hashing client addresses in quota counters (never stored raw, plan §12).
QUOTA_SALT=
